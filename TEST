  MAX(ncb.max_payment_char_6m) as max_payment_char_6m,
  MAX(ncb.max_payment_char_7_12m) as max_payment_char_7_12m,
  MAX(ncb.max_payment_char_13m_plus) as max_payment_char_13m_plus,
  MAX(ncb.max_payment_char_open) as max_payment_char_open,
  MAX(ncb.max_payment_char_6m_open) as max_payment_char_6m_open,
  MAX(ncb.max_payment_char_7_12m_open) as max_payment_char_7_12m_open,
  MAX(ncb.max_payment_char_13m_plus_open) as max_payment_char_13m_plus_open,
  MAX(ncb.max_payment_char_recent) as max_payment_char_recent,
  MAX(ncb.max_payment_char_6m_recent) as max_payment_char_6m_recent,
  MAX(ncb.max_payment_char_7_12m_recent) as max_payment_char_7_12m_recent,
  MAX(ncb.max_payment_char_13m_plus_recent) as max_payment_char_13m_plus_recent,
  MAX(ncb.max_latest_payment_char_recent) as max_latest_payment_char_recent,
  MAX(ncb.total_open_amount_owed) as ncb_total_open_amount_owed,
  MAX(ncb.total_open_credit_limit) as ncb_total_open_credit_limit,
  MAX(ncb.total_amount_pastdue) as ncb_total_amount_pastdue,
  MAX(ncb.total_credit_limit) as ncb_total_credit_limit,
  MAX(ncb.num_open_accounts) as ncb_num_open_accounts,
  MAX(ncb.num_closed_accounts) as ncb_num_closed_accounts,
  MAX(ncb.min_payment_history_length_open) as ncb_min_payment_history_length_open,
  MAX(ncb.max_payment_history_length) as ncb_max_payment_history_length,
  MAX(ncb.bankruptcy_status) as ncb_bankruptcy_status,
  MAX(ncb.count_1_first_12m) as ncb_count_1_first_12m,
  MAX(ncb.count_1_first_12m_open) as ncb_count_1_first_12m_open,
  MAX(ncb.count_1_first_12m_recent) as ncb_count_1_first_12m_recent,
  MAX(ncb.accounts_with_max_f) as ncb_accounts_with_max_f,
  MAX(ncb.latest_personal_loan_limit) as latest_personal_loan_limit,
  MAX(ncb.accounts_with_max_2) as ncb_accounts_with_max_2,
  MAX(ncb.num_ploan_accounts) as ncb_num_ploan_accounts,
  MAX(ncb.max_payment_char_gsb) as ncb_max_payment_char_gsb,
  MAX(ncb.is_consecutive_0_6m_overN) as ncb_is_consecutive_0_6m_overN,
  MAX(ncb.open_accounts_with_installment) as ncb_open_accounts_with_installment,
  MAX(ncb.credit_limit_open_with_installment) as ncb_credit_limit_open_with_installment,
  MAX(ncb.amount_owed_open_with_installment) as ncb_amount_owed_open_with_installment,
  MAX(ncb.max_payment_char_ploan) as ncb_max_payment_char_ploan,
  MAX(ncb.ploan_accounts_over_9m_history) as ncb_ploan_accounts_over_9m_history,
  MAX(ncb.closed_accounts_with_npl) as ncb_closed_accounts_with_npl,
  MAX(ncb.new_acc_Xdays) as ncb_new_acc_Xdays,
  MAX(ncb.old_closed_accounts_with_npl) as ncb_old_closed_accounts_with_npl,
  MAX(u.identity_type) AS authenChannel,
  MAX(u.account_status) AS account_status,
  MAX(rcl.status) AS rcl_status_mobile,
  MAX(CASE WHEN field_name = '_loan.loanApplicationNumber' THEN value END) AS loanApplicationNumber,
  MAX(CASE 
    WHEN field_name = '_loan.loanType' AND map_value = '7200' THEN 'P-LOAN'
    WHEN field_name = '_loan.loanType' AND map_value = '7900' THEN 'NANO'
  END) AS loanType,
  MAX(CASE WHEN field_name = '_loan.repaymentType' THEN map_value END) AS repaymentType,
  MAX(CASE WHEN field_name = '_loan.loanRequest' THEN value END) AS loanRequest,
  MAX(CASE WHEN field_name = '_loan.loanPeriodInMonth' THEN value END) AS loanPeriodInMonth,
  MAX(CASE WHEN field_name = 'scheduleSettings.fixedDaysOfMonth' THEN value END) AS fixedDaysOfMonth,
  MAX(CASE WHEN field_name = 'loanAmount' THEN value END) AS loanAmount,
  MAX(CASE WHEN field_name = 'scheduleSettings.repaymentInstallments' THEN map_value END) AS repaymentInstallments,
  MAX(CASE WHEN field_name = 'thinker.loanStatus' THEN value END) AS loanStatus,
  MAX(CASE WHEN field_name = 'thinker.caDecision' THEN value END) AS caDecision,
  MAX(IF(field_name = 'thinker.loanResult', map_value, NULL)) AS loanResult,
  MAX(IF(field_name = '_credit.ncbIssueDate', 
      FORMAT_DATE('%Y-%m-%d', DATE(TIMESTAMP_SECONDS(CAST(map_value AS INT)))),NULL)) AS ncbIssueDate,
  MAX(IF(field_name = '_credit.isNcbManualTads', map_value, NULL)) AS ncbGradeExtracted,
  MAX(CASE WHEN field_name = '_documents.4.content' THEN value END) IS NOT NULL AS is_upload_stm,

  MAX(CAST(ROUND(SAFE_CAST(k.avg_income_last_6_month AS NUMERIC), 0) AS INT64)) as avg_income_last_6_month,
  MAX(k.batch_id) as batch_id,
  MAX(k.validation_name_match) as validation_name_match,
  MAX(k.validation_transaction_latest_after_2) as validation_transaction_latest_after_2,
  MAX(k.validation_transaction_min_month_6) as validation_transaction_min_month_6,
  MAX(CAST(ROUND(SAFE_CAST(k.avg_monthly_salary AS NUMERIC), 0) AS INT64)) as avg_monthly_salary,
  MAX(k.longest_consecutive_salary_months) AS longest_consecutive_salary_months,
  MAX(CAST(ROUND(SAFE_CAST(k.avg_income_last_6_month_exclude_self_transfer AS NUMERIC), 0) AS INT64)) as avg_income_last_6_month_exclude_self_transfer,
  MAX(k.file_modified) AS file_modified,
  MAX(k.avg_balance_per_day) AS avg_balance_per_day,
  MAX(k.monthly_final_balances) AS monthly_final_balances,
  MAX(k.monthly_avg_balance_per_day) AS monthly_avg_balance_per_day,
  MAX(k.avg_monthly_wage) AS avg_monthly_wage,
  MAX(k.avg_monthly_revenue) AS avg_monthly_revenue,
  MAX(k.longest_consecutive_wage_months) AS longest_consecutive_wage_months,
  MAX(k.longest_consecutive_revenue_months) AS longest_consecutive_revenue_months,

  MAX(dstm.dstm_avg_credit) AS dstm_avg_credit,
  MAX(dstm.dstm_consecutive_salary) AS dstm_consecutive_salary,
  MAX(dstm_avg_salary) AS dstm_avg_salary,
  MAX(dstm_consecutive_credit) AS dstm_consecutive_credit,
  MAX(high_enquiry_no_subsequent_loan_flag) AS ncb_high_enquiry_no_subsequent_loan_flag,

FROM 
  customer_data cd
LEFT JOIN `loxbit-moneydd-bigquery-prod.x10.user_req_credit_line` rcl
  ON cd.case_id = rcl.case_id
LEFT JOIN `loxbit-moneydd-bigquery-prod.x10.user` u
  ON rcl.user_id = u.user_id
LEFT JOIN ncb_source_selection ncb
  ON ncb.case_id = cd.case_id
LEFT JOIN latest_app_data lad
  ON cd.case_id = lad.case_id
LEFT JOIN `report-mdd.uppass_dataset.key_result` k 
  ON cd.case_id = k.case_id
LEFT JOIN `report-mdd.credit_collection_risk.dstatement_key_result` dstm
  ON cd.case_id = dstm.case_id
LEFT JOIN `loxbit-moneydd-bigquery-prod.report.approver_name` ca_name
  ON cd.case_id = ca_name.case_id
GROUP BY cd.case_id, ca_name.ca_name
HAVING requestDate IS NOT NULL
ORDER BY requestDate DESC
