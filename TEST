      ELSE ncb_id.max_payment_char_6m
    END as max_payment_char_6m,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_7_12m
      ELSE ncb_id.max_payment_char_7_12m
    END as max_payment_char_7_12m,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_13m_plus
      ELSE ncb_id.max_payment_char_13m_plus
    END as max_payment_char_13m_plus,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_open
      ELSE ncb_id.max_payment_char_open
    END as max_payment_char_open,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_6m_open
      ELSE ncb_id.max_payment_char_6m_open
    END as max_payment_char_6m_open,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_7_12m_open
      ELSE ncb_id.max_payment_char_7_12m_open
    END as max_payment_char_7_12m_open,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_13m_plus_open
      ELSE ncb_id.max_payment_char_13m_plus_open
    END as max_payment_char_13m_plus_open,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_recent
      ELSE ncb_id.max_payment_char_recent
    END as max_payment_char_recent,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_6m_recent
      ELSE ncb_id.max_payment_char_6m_recent
    END as max_payment_char_6m_recent,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_7_12m_recent
      ELSE ncb_id.max_payment_char_7_12m_recent
    END as max_payment_char_7_12m_recent,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_13m_plus_recent
      ELSE ncb_id.max_payment_char_13m_plus_recent
    END as max_payment_char_13m_plus_recent,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.total_open_amount_owed
      ELSE ncb_id.total_open_amount_owed
    END as total_open_amount_owed,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.total_open_credit_limit
      ELSE ncb_id.total_open_credit_limit
    END as total_open_credit_limit,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.total_amount_pastdue
      ELSE ncb_id.total_amount_pastdue
    END as total_amount_pastdue,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.num_open_accounts
      ELSE ncb_id.num_open_accounts
    END as num_open_accounts,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.num_closed_accounts
      ELSE ncb_id.num_closed_accounts
    END as num_closed_accounts,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.min_payment_history_length_open
      ELSE ncb_id.min_payment_history_length_open
