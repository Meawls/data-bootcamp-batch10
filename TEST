    ncb_app.count_1_first_12m_open, ncb_id.count_1_first_12m_open,
    ncb_app.count_1_first_12m_recent, ncb_id.count_1_first_12m_recent,
    ncb_app.accounts_with_max_f, ncb_id.accounts_with_max_f,
    ncb_app.latest_personal_loan_limit, ncb_id.latest_personal_loan_limit,
    ncb_app.accounts_with_max_2, ncb_id.accounts_with_max_2,
    ncb_app.num_ploan_accounts, ncb_id.num_ploan_accounts,
    ncb_app.max_payment_char_gsb, ncb_id.max_payment_char_gsb,
    ncb_app.is_consecutive_0_6m_overN, ncb_id.is_consecutive_0_6m_overN,
    ncb_app.open_accounts_with_installment, ncb_id.open_accounts_with_installment,
    ncb_app.credit_limit_open_with_installment, ncb_id.credit_limit_open_with_installment,
    ncb_app.amount_owed_open_with_installment, ncb_id.amount_owed_open_with_installment,
    ncb_app.max_payment_char_ploan, ncb_id.max_payment_char_ploan,
    ncb_app.ploan_accounts_over_9m_history, ncb_id.ploan_accounts_over_9m_history,
    ncb_app.closed_accounts_with_npl, ncb_id.closed_accounts_with_npl,
    ncb_app.new_acc_Xdays, ncb_id.new_acc_Xdays,
    ncb_app.old_closed_accounts_with_npl, ncb_id.old_closed_accounts_with_npl,
    ncb_app.total_credit_limit, ncb_id.total_credit_limit,
    ncb_app.high_enquiry_no_subsequent_loan_flag, ncb_id.high_enquiry_no_subsequent_loan_flag,
    ncb_app.max_latest_payment_char_recent, ncb_id.max_latest_payment_char_recent
)

SELECT
  cd.case_id,
  MAX(CASE WHEN field_name = '_loan.requestDate' THEN DATE(DATETIME(TIMESTAMP_SECONDS(CAST(value AS INT64)), 'Asia/Bangkok')) END) AS requestDate,
  MAX(CASE WHEN field_name = '_loan.requestDate' THEN TIMESTAMP(DATETIME(TIMESTAMP_SECONDS(CAST(value AS INT64)), 'Asia/Bangkok')) END) AS requestDatetime,
  MAX(IF(field_name = 'thinker.caDecisionDate', DATE(DATETIME(TIMESTAMP_SECONDS(CAST(value AS INT64)), 'Asia/Bangkok')), NULL)) AS approvedDate,
  MAX(IF(field_name = 'firstName', value, NULL)) AS firstname,
  MAX(IF(field_name = 'lastName', value, NULL)) AS lastname,
  MAX(IF(field_name = 'thinker.caComments', map_value ,NULL)) AS ca_comment,
  MAX(CASE WHEN field_name = '_occupation.type' THEN map_value END) AS occupation,
  MAX(IF(field_name = '_customerInfo.ageYears', value, NULL)) AS ageYear,
  MAX(IF(field_name = '_customerInfo.nationalIdNumber', value, NULL)) AS nationalIdNumber,
  MAX(ncb.ncb_id_number) as ncb_id_number,
  MAX(CASE WHEN field_name = '_occupation.subType' THEN map_value END) AS occupation_subType,
  MAX(CASE WHEN field_name = '_occupation.period' THEN map_value END) AS occupation_period,
  MAX(CASE WHEN field_name = '_occupation.incomeAmount' THEN value END) AS incomeAmount,
  MAX(CASE WHEN field_name = '_credit.ncbIssuerAmount' THEN value END) AS ncbIssuerAmount,
  FORMAT('%.2f',MAX(CASE WHEN field_name = '_credit.debtServiceRatio' 
      THEN CAST(value AS float64) END)) AS debtServiceRatio,
  MAX(CASE WHEN field_name = '_gsb.aScoreGrade' THEN map_value END) AS aScore,
  MAX(CASE WHEN field_name = '_credit.ncbGrade' THEN map_value END) AS ncbScore,
  MAX(IF(field_name = '_credit.loanActiveAccount', value, NULL)) AS loanActiveAccount,
  MAX(IF(field_name = '_customerInfo.educationLevel', map_value, NULL)) AS educationLevel,
  MAX(CASE 
    WHEN ca_name.ca_name IS NOT NULL THEN ca_name.ca_name
    WHEN IF(field_name = 'thinker.loanResult', value, NULL) LIKE 'R%' THEN 'System'
    ELSE NULL
  END) AS approverName,
  
