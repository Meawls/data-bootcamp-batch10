WITH customer_data AS (
  SELECT 
      C.case_id, 
      C.field_name, 
      C.value,
      CASE WHEN M.th_text IS NOT NULL THEN M.th_text ELSE C.value END AS map_value
  FROM (
      SELECT 
          case_id, 
          field_name, 
          value,
          lastBatchDate,
          ROW_NUMBER() OVER (PARTITION BY case_id, field_name ORDER BY lastBatchDate DESC) AS row_num
      FROM `loxbit-moneydd-bigquery-prod.blockfint.question_taskpool-customer_data`
  ) C
  LEFT JOIN `loxbit-moneydd-bigquery-prod.report.los_field-masterdata` M
      ON C.field_name = M.fieldname AND C.value = M.value
  WHERE C.row_num = 1
  AND C.case_id IN (
      SELECT case_id
      FROM (
          SELECT 
              case_id, 
              field_name, 
              value,
              ROW_NUMBER() OVER (PARTITION BY case_id, field_name ORDER BY lastBatchDate DESC) AS row_num
          FROM `loxbit-moneydd-bigquery-prod.blockfint.question_taskpool-customer_data`
      ) SubQ
      WHERE SubQ.row_num = 1
      AND SubQ.field_name = '_loan.campaign' 
      AND SubQ.value = 'normal'
  )
),

case_request_dates AS (
  SELECT 
    case_id,
    TIMESTAMP_SECONDS(CAST(value AS INT64)) AS requestDate
  FROM customer_data
  WHERE field_name = '_loan.requestDate'
),

customer_ids AS (
  SELECT 
    case_id,
    MAX(CASE WHEN field_name = '_customerInfo.nationalIdNumber' THEN value END) AS nationalIdNumber
  FROM customer_data
  GROUP BY case_id
),

latest_ncb_by_id AS (
  SELECT 
    n.*,
    crd.requestDate,
    crd.case_id,
    ROW_NUMBER() OVER (
      PARTITION BY n.id_number, crd.case_id 
      ORDER BY n.update_time DESC
    ) as rn
  FROM `report-mdd.credit_collection_risk.ca_ncb_insight` n
  CROSS JOIN case_request_dates crd
  INNER JOIN customer_ids ci
    ON n.id_number = ci.nationalIdNumber
    AND ci.case_id = crd.case_id
  WHERE 
    n.id_number IS NOT NULL
    AND CAST(n.update_time AS TIMESTAMP) >= 
        TIMESTAMP_SUB(crd.requestDate, INTERVAL 45 DAY)
    AND CAST(n.update_time AS TIMESTAMP) <= 
        crd.requestDate
),

application_ncb AS (
  SELECT
    app_no,
    id_number,
    MAX(max_payment_char) AS max_payment_char,
    MAX(max_payment_char_6m) AS max_payment_char_6m,
    MAX(max_payment_char_7_12m) AS max_payment_char_7_12m,
    MAX(max_payment_char_13m_plus) AS max_payment_char_13m_plus,
    MAX(max_payment_char_open) AS max_payment_char_open,
    MAX(max_payment_char_6m_open) AS max_payment_char_6m_open,
    MAX(max_payment_char_7_12m_open) AS max_payment_char_7_12m_open,
    MAX(max_payment_char_13m_plus_open) AS max_payment_char_13m_plus_open,
    MAX(max_payment_char_recent) AS max_payment_char_recent,
    MAX(max_payment_char_6m_recent) AS max_payment_char_6m_recent,
    MAX(max_payment_char_7_12m_recent) AS max_payment_char_7_12m_recent,
    MAX(max_payment_char_13m_plus_recent) AS max_payment_char_13m_plus_recent,
    MAX(max_payment_char_gsb) AS max_payment_char_gsb,
    MAX(total_open_amount_owed) AS total_open_amount_owed,
    MAX(total_open_credit_limit) AS total_open_credit_limit,
    MAX(total_amount_pastdue) AS total_amount_pastdue,
    MAX(num_open_accounts) AS num_open_accounts,
    MAX(num_closed_accounts) AS num_closed_accounts,
    MAX(num_ploan_accounts) AS num_ploan_accounts,
    MAX(min_payment_history_length_open) AS min_payment_history_length_open,
    MAX(max_payment_history_length) AS max_payment_history_length,
    MAX(bankruptcy_status) AS bankruptcy_status,
    MAX(count_1_first_12m) AS count_1_first_12m,
    MAX(count_1_first_12m_open) AS count_1_first_12m_open,
    MAX(count_1_first_12m_recent) AS count_1_first_12m_recent,
    MAX(is_consecutive_0_6m_overN) AS is_consecutive_0_6m_overN,
    MAX(accounts_with_max_f) AS accounts_with_max_f,
    MAX(latest_personal_loan_limit) AS latest_personal_loan_limit,
    MAX(accounts_with_max_2) AS accounts_with_max_2,
    MAX(open_accounts_with_installment) AS open_accounts_with_installment,
    MAX(credit_limit_open_with_installment) AS credit_limit_open_with_installment,
    MAX(amount_owed_open_with_installment) AS amount_owed_open_with_installment, 
    MAX(max_payment_char_ploan) AS max_payment_char_ploan, 
    MAX(ploan_accounts_over_9m_history) AS ploan_accounts_over_9m_history, 
    MAX(closed_accounts_with_npl) AS closed_accounts_with_npl, 
    MAX(new_acc_Xdays) AS new_acc_Xdays,
    MAX(old_closed_accounts_with_npl) AS old_closed_accounts_with_npl,
    MAX(high_enquiry_no_subsequent_loan_flag) AS high_enquiry_no_subsequent_loan_flag,
    MAX(total_credit_limit) AS total_credit_limit,
    MAX(max_latest_payment_char_recent) AS max_latest_payment_char_recent
  FROM `report-mdd.credit_collection_risk.ca_ncb_insight`
  GROUP BY app_no,id_number
),

latest_app_data AS (
  SELECT 
    case_id,
    MAX(CASE WHEN field_name = '_customerInfo.nationalIdNumber' THEN value END) AS nationalIdNumber,
    MAX(CASE WHEN field_name = '_loan.loanApplicationNumber' THEN value END) AS loanApplicationNumber,
    PARSE_DATE('%y%m%d', SUBSTR(MAX(CASE WHEN field_name = '_loan.loanApplicationNumber' THEN value END), 4, 6)) AS app_date
  FROM customer_data
  GROUP BY case_id
),

-- New CTE to determine NCB source for each case
ncb_source_selection AS (
  SELECT 
    cd.case_id,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN 'application_ncb'
      WHEN ncb_id.max_payment_char IS NOT NULL THEN 'id_based_ncb_within_45days'
      ELSE 'no_ncb_data'
    END as ncb_data_source,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.id_number
      ELSE ncb_id.id_number
    END as ncb_id_number,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char
      ELSE ncb_id.max_payment_char
    END as max_payment_char,
    CASE 
