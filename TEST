    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.accounts_with_max_f
      ELSE ncb_id.accounts_with_max_f
    END as accounts_with_max_f,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.latest_personal_loan_limit
      ELSE ncb_id.latest_personal_loan_limit
    END as latest_personal_loan_limit,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.accounts_with_max_2
      ELSE ncb_id.accounts_with_max_2
    END as accounts_with_max_2,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.num_ploan_accounts
      ELSE ncb_id.num_ploan_accounts
    END as num_ploan_accounts,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_gsb
      ELSE ncb_id.max_payment_char_gsb
    END as max_payment_char_gsb,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.is_consecutive_0_6m_overN
      ELSE ncb_id.is_consecutive_0_6m_overN
    END as is_consecutive_0_6m_overN,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.open_accounts_with_installment
      ELSE ncb_id.open_accounts_with_installment
    END as open_accounts_with_installment,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.credit_limit_open_with_installment
      ELSE ncb_id.credit_limit_open_with_installment
    END as credit_limit_open_with_installment,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.amount_owed_open_with_installment
      ELSE ncb_id.amount_owed_open_with_installment
    END as amount_owed_open_with_installment,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_payment_char_ploan
      ELSE ncb_id.max_payment_char_ploan
    END as max_payment_char_ploan,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.ploan_accounts_over_9m_history
      ELSE ncb_id.ploan_accounts_over_9m_history
    END as ploan_accounts_over_9m_history,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.closed_accounts_with_npl
      ELSE ncb_id.closed_accounts_with_npl
    END as closed_accounts_with_npl,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.new_acc_Xdays
      ELSE ncb_id.new_acc_Xdays
    END as new_acc_Xdays,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.old_closed_accounts_with_npl
      ELSE ncb_id.old_closed_accounts_with_npl
    END as old_closed_accounts_with_npl,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.high_enquiry_no_subsequent_loan_flag
      ELSE ncb_id.high_enquiry_no_subsequent_loan_flag
    END as high_enquiry_no_subsequent_loan_flag,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.total_credit_limit
      ELSE ncb_id.total_credit_limit
    END as total_credit_limit,
    CASE 
      WHEN ncb_app.max_payment_char IS NOT NULL THEN ncb_app.max_latest_payment_char_recent
      ELSE ncb_id.max_latest_payment_char_recent
    END as max_latest_payment_char_recent
  FROM customer_data cd
  LEFT JOIN `loxbit-moneydd-bigquery-prod.x10.user_req_credit_line` rcl
    ON cd.case_id = rcl.case_id
  LEFT JOIN application_ncb ncb_app
    ON ncb_app.app_no = rcl.application_number
  LEFT JOIN latest_ncb_by_id ncb_id
    ON ncb_id.case_id = cd.case_id
    AND ncb_id.rn = 1
  GROUP BY cd.case_id, 
    ncb_app.max_payment_char, ncb_id.max_payment_char,
    ncb_app.id_number, ncb_id.id_number,
    ncb_app.max_payment_char_6m, ncb_id.max_payment_char_6m,
    ncb_app.max_payment_char_7_12m, ncb_id.max_payment_char_7_12m,
    ncb_app.max_payment_char_13m_plus, ncb_id.max_payment_char_13m_plus,
    ncb_app.max_payment_char_open, ncb_id.max_payment_char_open,
    ncb_app.max_payment_char_6m_open, ncb_id.max_payment_char_6m_open,
    ncb_app.max_payment_char_7_12m_open, ncb_id.max_payment_char_7_12m_open,
    ncb_app.max_payment_char_13m_plus_open, ncb_id.max_payment_char_13m_plus_open,
    ncb_app.max_payment_char_recent, ncb_id.max_payment_char_recent,
    ncb_app.max_payment_char_6m_recent, ncb_id.max_payment_char_6m_recent,
    ncb_app.max_payment_char_7_12m_recent, ncb_id.max_payment_char_7_12m_recent,
    ncb_app.max_payment_char_13m_plus_recent, ncb_id.max_payment_char_13m_plus_recent,
